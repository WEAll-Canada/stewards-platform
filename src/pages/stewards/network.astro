---
import ConnectSubnav from "../../components/ConnectSubnav.astro";
import Base from "../../layouts/Base.astro";
import { resolveAvatarSrc } from "../../lib/avatars";
import { currentUser } from "../../lib/auth";
import { CONNECTION_REASON_LEGEND } from "../../lib/network-map-config";
import { getNetworkGraph } from "../../lib/db";


const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const graph = await getNetworkGraph();
const provinces = [...new Set(graph.nodes.map((n) => (n.regions || "").trim()).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b),
);
const interests = [
  ...new Set(
    graph.nodes.flatMap((n) =>
      (n.interests || "")
        .split("|")
        .map((part) => part.trim())
        .filter(Boolean),
    ),
  ),
].sort((a, b) => a.localeCompare(b));

const payload = JSON.stringify({
  viewerId: String(user.id),
  nodes: graph.nodes.map((n) => {
    const name = n.display_name || "Steward";
    return {
      id: String(n.id),
      name,
      firstName: name.split(/\s+/)[0] || name,
      avatarSrc: resolveAvatarSrc(n.avatar_url, name),
      interests: (n.interests || "").split("|").filter(Boolean).slice(0, 3),
      regions: n.regions || "",
      sector: n.sector || "",
      profileType: n.profile_type === "partner" ? "partner" : "steward",
      isMe: n.id === user.id,
    };
  }),
  edges: graph.edges.map((e) => ({
    source: String(e.source),
    target: String(e.target),
    weight: e.strength,
    reason: e.reason || "",
  })),
});
---
<Base title="Connect · Network map" active="connect" user={user}>
  <h1>Connect</h1>
  <p class="lede">
    A living map of directory stewards and partners.
    Drag a person to rearrange, drag empty space to pan, scroll to zoom, click for details.
  </p>
  <ConnectSubnav active="network" />

  <p class="stats" aria-live="polite" data-map-stats>
    {graph.nodes.length} people · {graph.edges.length} connection{graph.edges.length === 1 ? "" : "s"}
  </p>

  <div class="map-shell" data-map-root>
    <div class="map-controls">
      <div class="map-controls__left">
        <button
          type="button"
          class="map-icon-btn"
          data-map-filters-toggle
          aria-expanded="false"
          aria-controls="map-filters-panel"
          aria-label="Open map filters"
          title="Filters"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"></path>
          </svg>
        </button>
        <div class="map-filters" id="map-filters-panel" data-map-filters hidden>
          <div class="map-filters__section">
            <p class="map-filters__heading">Show</p>
            <label class="map-filters__check">
              <input type="checkbox" name="type" value="steward" checked data-filter-type />
              Stewards
            </label>
            <label class="map-filters__check">
              <input type="checkbox" name="type" value="partner" checked data-filter-type />
              Partners
            </label>
          </div>
          <div class="map-filters__section">
            <p class="map-filters__heading">Province / region</p>
            <label class="map-filters__check">
              <input type="radio" name="province" value="" checked data-filter-province />
              All regions
            </label>
            {provinces.map((province) => (
              <label class="map-filters__check">
                <input type="radio" name="province" value={province} data-filter-province />
                {province}
              </label>
            ))}
          </div>
          <div class="map-filters__section">
            <p class="map-filters__heading">Highlight interest</p>
            <label class="map-filters__check">
              <input type="radio" name="interest" value="" checked data-filter-interest />
              None
            </label>
            {interests.map((interest) => (
              <label class="map-filters__check">
                <input type="radio" name="interest" value={interest} data-filter-interest />
                {interest}
              </label>
            ))}
          </div>
          <button type="button" class="btn btn--quiet map-filters__reset" data-filter-reset>Reset filters</button>
        </div>
      </div>
      <button
        type="button"
        class="map-icon-btn map-icon-btn--fullscreen"
        data-map-fullscreen
        aria-pressed="false"
        aria-label="Full screen"
        title="Full screen"
      >
        <svg class="icon-expand" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M7 14H5v5h5v-2H7v-3zm12 0h-2v3h-3v2h5v-5zM7 5h3V3H5v5h2V5zm12-2h-5v2h3v3h2V3z"
          ></path>
        </svg>
        <svg class="icon-compress" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"
          ></path>
        </svg>
      </button>
    </div>

    <svg class="network-map" role="img" aria-label="Steward network map" data-map-svg></svg>
    <aside class="map-panel" data-panel hidden>
      <div class="map-panel__identity">
        <img data-panel-avatar alt="" width="48" height="48" />
        <div>
          <h2 data-panel-name>—</h2>
          <p class="meta" data-panel-meta></p>
        </div>
      </div>
      <ul class="tags" data-panel-tags></ul>
      <div class="panel-actions">
        <a class="btn btn--quiet" data-panel-dir href="/stewards/directory">Directory</a>
        <a class="btn btn--accent" data-panel-msg href="/stewards/messages">Message</a>
        <a class="btn btn--primary" data-panel-match href="/stewards/connect">Find similar</a>
      </div>
      <button type="button" class="btn btn--quiet panel-close" data-panel-close>Close</button>
    </aside>
  </div>

  <div class="legend">
    <span><i class="swatch swatch--you"></i> You</span>
    <span><i class="swatch swatch--steward"></i> Steward</span>
    <span><i class="swatch swatch--partner"></i> Partner</span>
    <span><i class="swatch swatch--highlight"></i> Highlighted interest</span>
    {CONNECTION_REASON_LEGEND.map((item) => (
      <span><i class="swatch" style={`background:${item.color}`}></i> {item.label}</span>
    ))}
  </div>

  <script id="network-data" type="application/json" is:inline set:html={payload}></script>
</Base>

<style>
  .lede {
    color: var(--color-ink-soft);
    max-width: 44rem;
  }

  .stats {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-3);
  }

  .map-shell {
    position: relative;
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
    background: #f8fafc;
    min-height: 28rem;
    overflow: hidden;
  }

  .map-shell:fullscreen {
    border: none;
    border-radius: 0;
    width: 100%;
    height: 100%;
    background: #f8fafc;
  }

  .map-shell:fullscreen .network-map {
    height: 100%;
  }

  .map-controls {
    position: absolute;
    inset: var(--space-3) var(--space-3) auto;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
  }

  .map-controls__left,
  .map-icon-btn {
    pointer-events: auto;
  }

  .map-controls__left {
    position: relative;
  }

  .map-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-surface-subtle);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
  }

  .map-icon-btn:hover,
  .map-icon-btn[aria-expanded="true"],
  .map-icon-btn[aria-pressed="true"] {
    background: var(--color-surface-subtle);
  }

  /* Only one fullscreen glyph at a time (SVG `hidden` is unreliable here). */
  .map-icon-btn--fullscreen .icon-compress {
    display: none;
  }

  .map-icon-btn--fullscreen[aria-pressed="true"] .icon-expand {
    display: none;
  }

  .map-icon-btn--fullscreen[aria-pressed="true"] .icon-compress {
    display: block;
  }

  .map-filters {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    width: min(18rem, calc(100vw - 3rem));
    max-height: min(28rem, 70vh);
    overflow: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .map-filters[hidden] {
    display: none;
  }

  .map-filters__heading {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .map-filters__section {
    display: grid;
    gap: 0.35rem;
  }

  .map-filters__check {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .map-filters__reset {
    justify-self: start;
  }

  .network-map {
    width: 100%;
    height: min(75vh, 42rem);
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .network-map:active {
    cursor: grabbing;
  }

  .map-panel {
    position: absolute;
    right: var(--space-4);
    top: calc(var(--space-4) + 2.6rem);
    width: min(18rem, calc(100% - 2rem));
    background: var(--color-surface);
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
    z-index: 2;
  }

  .map-panel[hidden] {
    display: none;
  }

  .map-panel__identity {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  .map-panel__identity img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface-subtle);
  }

  .map-panel h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .meta {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tags li {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-surface-subtle);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .swatch {
    display: inline-block;
    width: 0.85rem;
    height: 0.35rem;
    border-radius: 2px;
  }

  .swatch--you {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: #fdda24;
    outline: 2px solid #000;
  }

  .swatch--steward {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: #fff;
    outline: 2px solid #00a9e0;
  }

  .swatch--partner {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: #fff;
    outline: 2px solid #ff8200;
  }

  .swatch--highlight {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: #e0f4fb;
    outline: 2px solid #0c4da2;
  }
</style>

<script>
  import { NODE_RING } from "../../lib/network-map-config";
  import {
    DEFAULT_PARTICIPANT_MAP_CONFIG,
    applyAmbientFloat,
    captureHomes,
    createSimNodes,
    settleLayout,
    simulateStep,
    curvedPath,
    edgeEndpoints,
    edgeColor,
    wheelZoomFactor,
    type MapEdge,
    type MapNode,
    type SimNode,
  } from "../../lib/network-map-layout";

  type GraphPayload = {
    viewerId: string;
    nodes: MapNode[];
    edges: MapEdge[];
  };

  type EdgeEl = { source: string; target: string; el: SVGPathElement; weight: number; reason: string };
  type NodeEl = { id: string; el: SVGGElement; halo: SVGCircleElement };

  type FilterState = {
    types: Set<string>;
    province: string;
    interest: string;
  };

  const raw = document.getElementById("network-data")?.textContent ?? "{}";
  const data = JSON.parse(raw) as GraphPayload;
  const root = document.querySelector<HTMLElement>("[data-map-root]");
  const svg = document.querySelector<SVGSVGElement>("[data-map-svg]");
  const panel = document.querySelector<HTMLElement>("[data-panel]");
  const statsEl = document.querySelector<HTMLElement>("[data-map-stats]");
  const fullscreenBtn = document.querySelector<HTMLButtonElement>("[data-map-fullscreen]");
  const filtersToggle = document.querySelector<HTMLButtonElement>("[data-map-filters-toggle]");
  const filtersPanel = document.querySelector<HTMLElement>("[data-map-filters]");
  const resetBtn = document.querySelector<HTMLButtonElement>("[data-filter-reset]");
  if (!root || !svg || !panel) throw new Error("Network map missing root elements");

  const panelName = panel.querySelector("[data-panel-name]")!;
  const panelMeta = panel.querySelector("[data-panel-meta]")!;
  const panelTags = panel.querySelector("[data-panel-tags]")!;
  const panelAvatar = panel.querySelector<HTMLImageElement>("[data-panel-avatar]")!;
  const panelDir = panel.querySelector<HTMLAnchorElement>("[data-panel-dir]")!;
  const panelMsg = panel.querySelector<HTMLAnchorElement>("[data-panel-msg]")!;
  const panelMatch = panel.querySelector<HTMLAnchorElement>("[data-panel-match]")!;
  const panelClose = panel.querySelector("[data-panel-close]")!;

  const ns = "http://www.w3.org/2000/svg";
  const config = DEFAULT_PARTICIPANT_MAP_CONFIG;

  let width = Math.max(root.clientWidth || 900, 320);
  let height = Math.max(Math.min(width * 0.65, 560), 380);
  let view = { x: 0, y: 0, k: 1 };
  let nodes: SimNode[] = [];
  let selectedId: string | null = null;
  let hoveredId: string | null = null;
  let edgeEls: EdgeEl[] = [];
  let nodeEls: NodeEl[] = [];
  let visibleIds = new Set(data.nodes.map((n) => n.id));
  let floatFrame = 0;
  let simFrame = 0;
  let layoutEdges: MapEdge[] = data.edges;
  let filters: FilterState = {
    types: new Set(["steward", "partner"]),
    province: "",
    interest: "",
  };
  const nodeDrag = {
    active: false,
    nodeId: null as string | null,
    pointerId: null as number | null,
    startX: 0,
    startY: 0,
    moved: false,
  };

  const viewport = document.createElementNS(ns, "g");
  viewport.setAttribute("data-viewport", "true");
  svg.appendChild(viewport);

  const panRect = document.createElementNS(ns, "rect");
  panRect.setAttribute("fill", "transparent");
  panRect.setAttribute("data-pan", "true");
  viewport.appendChild(panRect);

  const edgeLayer = document.createElementNS(ns, "g");
  const nodeLayer = document.createElementNS(ns, "g");
  viewport.appendChild(edgeLayer);
  viewport.appendChild(nodeLayer);

  function applyView() {
    viewport.setAttribute("transform", `translate(${view.x} ${view.y}) scale(${view.k})`);
  }

  function readFilters(): FilterState {
    const types = new Set(
      [...document.querySelectorAll<HTMLInputElement>("[data-filter-type]:checked")].map((el) => el.value),
    );
    const province =
      document.querySelector<HTMLInputElement>("[data-filter-province]:checked")?.value ?? "";
    const interest =
      document.querySelector<HTMLInputElement>("[data-filter-interest]:checked")?.value ?? "";
    return { types, province, interest };
  }

  function nodePassesFilters(node: MapNode, state: FilterState) {
    if (!state.types.has(node.profileType || "steward")) return false;
    if (state.province && node.regions !== state.province) return false;
    return true;
  }

  function computeVisible(state: FilterState) {
    return new Set(data.nodes.filter((n) => nodePassesFilters(n, state)).map((n) => n.id));
  }

  function spotlightSet() {
    if (!hoveredId && !selectedId) return null;
    const focus = hoveredId ?? selectedId!;
    if (!visibleIds.has(focus)) return null;
    const neighbors = new Set<string>([focus]);
    for (const edge of data.edges) {
      if (!visibleIds.has(edge.source) || !visibleIds.has(edge.target)) continue;
      if (edge.source === focus) neighbors.add(edge.target);
      if (edge.target === focus) neighbors.add(edge.source);
    }
    return neighbors;
  }

  function ringFor(node: MapNode | SimNode) {
    if (node.isMe) return { stroke: NODE_RING.you, width: "3", fill: "#fff" };
    if (node.profileType === "partner") return { stroke: NODE_RING.partner, width: "2.5", fill: "#fff" };
    return { stroke: NODE_RING.steward, width: "2.5", fill: "#fff" };
  }

  function applySpotlight() {
    const spotlight = spotlightSet();
    for (const edge of edgeEls) {
      const bothVisible = visibleIds.has(edge.source) && visibleIds.has(edge.target);
      if (!bothVisible) {
        edge.el.setAttribute("stroke-opacity", "0");
        continue;
      }
      const dim = spotlight && !(spotlight.has(edge.source) && spotlight.has(edge.target));
      edge.el.setAttribute("stroke-opacity", dim ? "0.12" : "0.75");
    }
    for (const node of nodeEls) {
      if (!visibleIds.has(node.id)) {
        node.el.setAttribute("opacity", "0");
        node.el.style.pointerEvents = "none";
        continue;
      }
      node.el.style.pointerEvents = nodeDrag.active ? "none" : "auto";
      if (nodeDrag.active && nodeDrag.nodeId === node.id) {
        node.el.style.pointerEvents = "auto";
      }
      const source = nodes.find((n) => n.id === node.id) ?? data.nodes.find((n) => n.id === node.id);
      if (!source) continue;
      const highlighted = Boolean(filters.interest && source.interests.includes(filters.interest));
      if (highlighted) {
        node.halo.setAttribute("stroke", NODE_RING.highlight);
        node.halo.setAttribute("stroke-width", "3.5");
        node.halo.setAttribute("fill", "#e0f4fb");
      } else {
        const ring = ringFor(source);
        node.halo.setAttribute("stroke", ring.stroke);
        node.halo.setAttribute("stroke-width", ring.width);
        node.halo.setAttribute("fill", ring.fill);
      }
      const dimBySpotlight = spotlight && !spotlight.has(node.id);
      const dimByInterest = Boolean(filters.interest && !highlighted && !source.isMe);
      node.el.setAttribute("opacity", dimBySpotlight || dimByInterest ? "0.22" : "1");
    }
  }

  function updateStats() {
    if (!statsEl) return;
    const visibleEdges = data.edges.filter((e) => visibleIds.has(e.source) && visibleIds.has(e.target)).length;
    statsEl.textContent = `${visibleIds.size} people · ${visibleEdges} connection${visibleEdges === 1 ? "" : "s"}`;
  }

  function applyFilters(relayoutNeeded = false) {
    filters = readFilters();
    visibleIds = computeVisible(filters);
    if (selectedId && !visibleIds.has(selectedId)) {
      selectedId = null;
      panel.hidden = true;
    }
    updateStats();
    if (relayoutNeeded) {
      relayout();
      return;
    }
    applySpotlight();
  }

  function openPanel(node: SimNode) {
    selectedId = node.id;
    panel.hidden = false;
    panelName.textContent = node.name;
    const typeLabel = node.profileType === "partner" ? "Partner" : "Steward";
    panelMeta.textContent = [typeLabel, node.regions, node.sector].filter(Boolean).join(" · ") || typeLabel;
    panelAvatar.src = node.avatarSrc;
    panelAvatar.alt = node.name;
    panelTags.replaceChildren();
    for (const tag of node.interests) {
      const li = document.createElement("li");
      li.textContent = tag;
      panelTags.appendChild(li);
    }
    panelDir.href = `/stewards/directory?q=${encodeURIComponent(node.name)}`;
    panelMsg.href = `/stewards/messages?with=${node.id}`;
    panelMatch.href = node.interests[0]
      ? `/stewards/connect?q=${encodeURIComponent(node.interests[0])}`
      : "/stewards/connect";
    applySpotlight();
  }

  function paintPositions() {
    const byId = new Map(nodes.map((n) => [n.id, n]));
    for (const edge of edgeEls) {
      const a = byId.get(edge.source);
      const b = byId.get(edge.target);
      if (!a || !b) continue;
      const ends = edgeEndpoints(a.x, a.y, a.radius, b.x, b.y, b.radius);
      edge.el.setAttribute("d", curvedPath(ends.x1, ends.y1, ends.x2, ends.y2, `${edge.source}:${edge.target}`));
    }
    for (const node of nodeEls) {
      const sim = byId.get(node.id);
      if (!sim) continue;
      node.el.setAttribute("transform", `translate(${sim.x},${sim.y})`);
    }
  }

  function buildGraph() {
    edgeLayer.replaceChildren();
    nodeLayer.replaceChildren();
    edgeEls = [];
    nodeEls = [];
    const byId = new Map(nodes.map((n) => [n.id, n]));

    for (const edge of layoutEdges) {
      const a = byId.get(edge.source);
      const b = byId.get(edge.target);
      if (!a || !b) continue;
      const ends = edgeEndpoints(a.x, a.y, a.radius, b.x, b.y, b.radius);
      const path = document.createElementNS(ns, "path");
      path.setAttribute("d", curvedPath(ends.x1, ends.y1, ends.x2, ends.y2, `${edge.source}:${edge.target}`));
      path.setAttribute("fill", "none");
      path.setAttribute("stroke", edgeColor(edge.reason));
      path.setAttribute("stroke-width", String(1.5 + edge.weight * 0.75));
      path.setAttribute("stroke-opacity", "0.85");
      path.setAttribute("stroke-linecap", "round");
      path.style.transition = "stroke-opacity 450ms ease";
      edgeLayer.appendChild(path);
      edgeEls.push({
        source: edge.source,
        target: edge.target,
        el: path,
        weight: edge.weight,
        reason: edge.reason,
      });
    }

    for (const node of nodes) {
      const g = document.createElementNS(ns, "g");
      g.setAttribute("data-node", node.id);
      g.setAttribute("transform", `translate(${node.x},${node.y})`);
      g.style.cursor = "grab";
      g.style.transition = "opacity 450ms ease";

      const ring = ringFor(node);
      const halo = document.createElementNS(ns, "circle");
      halo.setAttribute("r", String(node.radius + 5));
      halo.setAttribute("fill", ring.fill);
      halo.setAttribute("stroke", ring.stroke);
      halo.setAttribute("stroke-width", ring.width);
      g.appendChild(halo);

      const clipId = `clip-${node.id}`;
      const defs = document.createElementNS(ns, "defs");
      const clip = document.createElementNS(ns, "clipPath");
      clip.setAttribute("id", clipId);
      const clipCircle = document.createElementNS(ns, "circle");
      clipCircle.setAttribute("r", String(node.radius));
      clip.appendChild(clipCircle);
      defs.appendChild(clip);
      g.appendChild(defs);

      const img = document.createElementNS(ns, "image");
      img.setAttributeNS("http://www.w3.org/1999/xlink", "href", node.avatarSrc);
      img.setAttribute("href", node.avatarSrc);
      img.setAttribute("x", String(-node.radius));
      img.setAttribute("y", String(-node.radius));
      img.setAttribute("width", String(node.radius * 2));
      img.setAttribute("height", String(node.radius * 2));
      img.setAttribute("clip-path", `url(#${clipId})`);
      img.setAttribute("preserveAspectRatio", "xMidYMid slice");
      g.appendChild(img);

      const label = document.createElementNS(ns, "text");
      label.textContent = node.firstName;
      label.setAttribute("y", String(node.radius + 16));
      label.setAttribute("text-anchor", "middle");
      label.setAttribute("font-size", "12");
      label.setAttribute("font-family", "Lato, sans-serif");
      label.setAttribute("font-weight", "700");
      label.setAttribute("fill", "#0f172a");
      g.appendChild(label);

      const hit = document.createElementNS(ns, "circle");
      hit.setAttribute("r", String(node.radius + 12));
      hit.setAttribute("fill", "transparent");
      hit.style.cursor = "grab";
      g.appendChild(hit);

      g.addEventListener("pointerenter", () => {
        if (nodeDrag.active) return;
        hoveredId = node.id;
        applySpotlight();
      });
      g.addEventListener("pointerleave", () => {
        if (nodeDrag.active) return;
        hoveredId = null;
        applySpotlight();
      });
      hit.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        event.stopPropagation();
        event.preventDefault();
        stopFloat();
        stopSim();
        const point = clientToGraph(event.clientX, event.clientY);
        node.fx = point.x;
        node.fy = point.y;
        node.x = point.x;
        node.y = point.y;
        nodeDrag.active = true;
        nodeDrag.nodeId = node.id;
        nodeDrag.pointerId = event.pointerId;
        nodeDrag.startX = event.clientX;
        nodeDrag.startY = event.clientY;
        nodeDrag.moved = false;
        g.style.cursor = "grabbing";
        hit.style.cursor = "grabbing";
        hit.setPointerCapture(event.pointerId);
        paintPositions();
      });
      hit.addEventListener("pointermove", (event) => {
        if (!nodeDrag.active || nodeDrag.nodeId !== node.id || nodeDrag.pointerId !== event.pointerId) {
          return;
        }
        if (
          !nodeDrag.moved &&
          Math.hypot(event.clientX - nodeDrag.startX, event.clientY - nodeDrag.startY) > 5
        ) {
          nodeDrag.moved = true;
        }
        const point = clientToGraph(event.clientX, event.clientY);
        node.fx = point.x;
        node.fy = point.y;
        node.x = point.x;
        node.y = point.y;
        paintPositions();
      });
      const endNodeDrag = (event: PointerEvent) => {
        if (!nodeDrag.active || nodeDrag.nodeId !== node.id || nodeDrag.pointerId !== event.pointerId) {
          return;
        }
        const wasClick = !nodeDrag.moved;
        try {
          hit.releasePointerCapture(event.pointerId);
        } catch {
          /* ignore */
        }
        g.style.cursor = "grab";
        hit.style.cursor = "grab";
        nodeDrag.active = false;
        nodeDrag.nodeId = null;
        nodeDrag.pointerId = null;

        if (wasClick) {
          if (node.isIsolate) {
            node.fx = node.homeX;
            node.fy = node.homeY;
            node.x = node.homeX;
            node.y = node.homeY;
          } else {
            node.fx = null;
            node.fy = null;
          }
          openPanel(node);
          startFloat();
          return;
        }

        // Keep isolates where dropped; let connected nodes re-spring into place.
        if (node.isIsolate) {
          node.homeX = node.x;
          node.homeY = node.y;
          node.fx = node.x;
          node.fy = node.y;
          captureHomes(nodes);
          startFloat();
        } else {
          node.fx = null;
          node.fy = null;
          reheatSimulation();
        }
      };
      hit.addEventListener("pointerup", endNodeDrag);
      hit.addEventListener("pointercancel", endNodeDrag);

      nodeLayer.appendChild(g);
      nodeEls.push({ id: node.id, el: g, halo });
    }

    applySpotlight();
  }

  function clientToGraph(clientX: number, clientY: number) {
    const rect = svg.getBoundingClientRect();
    return {
      x: (clientX - rect.left - view.x) / view.k,
      y: (clientY - rect.top - view.y) / view.k,
    };
  }

  function stopFloat() {
    if (floatFrame) {
      cancelAnimationFrame(floatFrame);
      floatFrame = 0;
    }
  }

  function stopSim() {
    if (simFrame) {
      cancelAnimationFrame(simFrame);
      simFrame = 0;
    }
  }

  function startFloat() {
    stopFloat();
    const step = (timeMs: number) => {
      if (nodeDrag.active) {
        floatFrame = requestAnimationFrame(step);
        return;
      }
      applyAmbientFloat(nodes, timeMs);
      paintPositions();
      floatFrame = requestAnimationFrame(step);
    };
    floatFrame = requestAnimationFrame(step);
  }

  function reheatSimulation() {
    stopFloat();
    stopSim();
    let alpha = 0.55;
    const step = () => {
      if (alpha <= config.alpha_min) {
        for (const node of nodes) {
          node.vx = 0;
          node.vy = 0;
        }
        captureHomes(nodes);
        simFrame = 0;
        startFloat();
        return;
      }
      simulateStep(nodes, layoutEdges, width, height, alpha, config);
      alpha *= 1 - config.alpha_decay;
      paintPositions();
      applySpotlight();
      simFrame = requestAnimationFrame(step);
    };
    simFrame = requestAnimationFrame(step);
  }

  function relayout() {
    stopFloat();
    stopSim();
    width = Math.max(root.clientWidth || 900, 320);
    height = Math.max(Math.min(width * 0.7, 620), 420);
    if (document.fullscreenElement === root) {
      height = Math.max(root.clientHeight || height, 420);
    }
    svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
    svg.setAttribute("width", String(width));
    svg.setAttribute("height", String(height));
    panRect.setAttribute("width", String(width));
    panRect.setAttribute("height", String(height));
    const layoutNodes = data.nodes.filter((n) => visibleIds.has(n.id));
    layoutEdges = data.edges.filter((e) => visibleIds.has(e.source) && visibleIds.has(e.target));
    nodes = createSimNodes(layoutNodes, layoutEdges, width, height, config);
    settleLayout(nodes, layoutEdges, width, height, config);
    captureHomes(nodes);
    view = { x: 0, y: 0, k: 1 };
    buildGraph();
    applyView();
    startFloat();
  }

  applyFilters(true);
  window.addEventListener("resize", relayout);
  window.addEventListener("pagehide", () => {
    stopFloat();
    stopSim();
  });

  const pan = { active: false, startX: 0, startY: 0, originX: 0, originY: 0 };
  panRect.addEventListener("pointerdown", (event) => {
    if (event.button !== 0 || nodeDrag.active) return;
    pan.active = true;
    pan.startX = event.clientX;
    pan.startY = event.clientY;
    pan.originX = view.x;
    pan.originY = view.y;
    panRect.setPointerCapture(event.pointerId);
  });
  panRect.addEventListener("pointermove", (event) => {
    if (!pan.active) return;
    view.x = pan.originX + (event.clientX - pan.startX);
    view.y = pan.originY + (event.clientY - pan.startY);
    applyView();
  });
  const endDrag = (event: PointerEvent) => {
    if (!pan.active) return;
    pan.active = false;
    try {
      panRect.releasePointerCapture(event.pointerId);
    } catch {
      /* ignore */
    }
  };
  panRect.addEventListener("pointerup", (event) => {
    const moved = Math.hypot(event.clientX - pan.startX, event.clientY - pan.startY) > 6;
    endDrag(event);
    if (!moved && !nodeDrag.active) {
      panel.hidden = true;
      selectedId = null;
      applySpotlight();
    }
  });
  panRect.addEventListener("pointercancel", endDrag);

  svg.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();
      const rect = svg.getBoundingClientRect();
      const mx = event.clientX - rect.left;
      const my = event.clientY - rect.top;
      const scaleFactor = wheelZoomFactor(event.deltaY);
      const nextK = Math.min(2.8, Math.max(0.35, view.k * scaleFactor));
      view = {
        k: nextK,
        x: mx - ((mx - view.x) * nextK) / view.k,
        y: my - ((my - view.y) * nextK) / view.k,
      };
      applyView();
    },
    { passive: false },
  );

  panelClose.addEventListener("click", () => {
    panel.hidden = true;
    selectedId = null;
    applySpotlight();
  });

  function syncFullscreenChrome() {
    if (!fullscreenBtn) return;
    const on = document.fullscreenElement === root;
    fullscreenBtn.setAttribute("aria-pressed", on ? "true" : "false");
    fullscreenBtn.setAttribute("aria-label", on ? "Exit full screen" : "Full screen");
    fullscreenBtn.title = on ? "Exit full screen" : "Full screen";
  }

  fullscreenBtn?.addEventListener("click", async () => {
    try {
      if (document.fullscreenElement === root) {
        await document.exitFullscreen();
      } else {
        await root.requestFullscreen();
      }
    } catch {
      /* browser blocked fullscreen */
    }
  });

  document.addEventListener("fullscreenchange", () => {
    syncFullscreenChrome();
    relayout();
  });

  filtersToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (!filtersPanel || !filtersToggle) return;
    const open = filtersPanel.hidden;
    filtersPanel.hidden = !open;
    filtersToggle.setAttribute("aria-expanded", open ? "true" : "false");
    filtersToggle.setAttribute("aria-label", open ? "Close map filters" : "Open map filters");
  });

  document.addEventListener("click", (event) => {
    if (!filtersPanel || !filtersToggle || filtersPanel.hidden) return;
    const target = event.target as Node;
    if (filtersPanel.contains(target) || filtersToggle.contains(target)) return;
    filtersPanel.hidden = true;
    filtersToggle.setAttribute("aria-expanded", "false");
    filtersToggle.setAttribute("aria-label", "Open map filters");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !filtersPanel || !filtersToggle || filtersPanel.hidden) return;
    filtersPanel.hidden = true;
    filtersToggle.setAttribute("aria-expanded", "false");
    filtersToggle.setAttribute("aria-label", "Open map filters");
  });

  document.querySelectorAll<HTMLInputElement>("[data-filter-type], [data-filter-province]").forEach((el) => {
    el.addEventListener("change", () => applyFilters(true));
  });
  document.querySelectorAll<HTMLInputElement>("[data-filter-interest]").forEach((el) => {
    el.addEventListener("change", () => applyFilters(false));
  });

  resetBtn?.addEventListener("click", () => {
    document.querySelectorAll<HTMLInputElement>("[data-filter-type]").forEach((el) => {
      el.checked = true;
    });
    const allProvince = document.querySelector<HTMLInputElement>('[data-filter-province][value=""]');
    if (allProvince) allProvince.checked = true;
    const noInterest = document.querySelector<HTMLInputElement>('[data-filter-interest][value=""]');
    if (noInterest) noInterest.checked = true;
    applyFilters(true);
  });
</script>
