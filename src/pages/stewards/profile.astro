---
import StewardAvatar from "../../components/StewardAvatar.astro";
import Base from "../../layouts/Base.astro";
import { AVATAR_PRESETS, resolveAvatarSrc } from "../../lib/avatars";
import { currentUser } from "../../lib/auth";
import { getProfileBundle } from "../../lib/db";
import { INTERESTS, PROFILE_TYPES, SECTORS } from "../../lib/survey";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const profile = await getProfileBundle(user.id);
if (!profile) return Astro.redirect("/stewards/dashboard");

const selectedInterests = new Set((profile.interests || "").split("|").filter(Boolean));
const tabParam = Astro.url.searchParams.get("tab");
const activeTab = tabParam === "settings" ? "settings" : "profile";
const previewSrc = resolveAvatarSrc(profile.avatar_url, profile.display_name);
---
<Base title={activeTab === "settings" ? "Settings" : "Profile"} active="profile" user={user}>
  <h1>Your account</h1>
  <p class="lede">Update how you appear to other stewards and what you receive.</p>

  <div class="tabs" role="tablist" aria-label="Account sections">
    <a
      class:list={["tabs__tab", { "is-active": activeTab === "profile" }]}
      href="/stewards/profile?tab=profile"
      role="tab"
      aria-selected={activeTab === "profile"}
      id="tab-profile"
    >
      Profile
    </a>
    <a
      class:list={["tabs__tab", { "is-active": activeTab === "settings" }]}
      href="/stewards/profile?tab=settings"
      role="tab"
      aria-selected={activeTab === "settings"}
      id="tab-settings"
    >
      Settings
    </a>
  </div>

  {activeTab === "profile" ? (
    <section class="tab-panel" role="tabpanel" aria-labelledby="tab-profile">
      <form id="profile-form" class="stack survey" style="max-width: 40rem;">
        <div class="avatar-editor">
          <img
            id="avatar-preview"
            class="avatar-editor__preview"
            src={previewSrc}
            alt=""
            width="96"
            height="96"
          />
          <div class="avatar-editor__controls">
            <p class="hint">Photo thumbnail (small square — keeps the directory fast)</p>
            <input type="hidden" name="avatar_url" id="avatar_url" value={profile.avatar_url || ""} />
            <label class="btn btn--quiet avatar-upload">
              Upload photo
              <input id="avatar-file" type="file" accept="image/*" hidden />
            </label>
            <fieldset class="avatar-presets">
              <legend>Or use a prepared thumbnail</legend>
              <div class="avatar-presets__grid">
                {AVATAR_PRESETS.map((p) => (
                  <button
                    type="button"
                    class:list={["avatar-preset", { "is-selected": profile.avatar_url === `preset:${p.id}` }]}
                    data-preset={`preset:${p.id}`}
                    aria-label={p.label}
                  >
                    <StewardAvatar name={p.label} avatarUrl={`preset:${p.id}`} />
                  </button>
                ))}
              </div>
            </fieldset>
          </div>
        </div>

        <label>
          Display name
          <input name="display_name" required maxlength="100" value={profile.display_name} />
        </label>

        <fieldset>
          <legend>Type of profile</legend>
          {PROFILE_TYPES.map((t) => (
            <label class="check">
              <input type="radio" name="profile_type" value={t.value} checked={profile.profile_type === t.value} />
              {t.label}
            </label>
          ))}
        </fieldset>

        <label>
          Contact
          <span class="hint">Website, email, LinkedIn, Instagram, etc.</span>
          <textarea name="contact_links" rows="3" maxlength="4000">{profile.contact_links}</textarea>
        </label>

        <label>
          Location / regions
          <span class="hint">Eg: Canada (national), Manitoba (provincial), or a neighbourhood (like Parkdale).</span>
          <input name="regions" maxlength="500" value={profile.regions || profile.location} />
        </label>

        <label>
          Address <span class="optional">(optional)</span>
          <span class="hint">For a future geographic map.</span>
          <input name="map_address" maxlength="500" value={profile.map_address} />
        </label>

        <label>
          Sector
          <select name="sector">
            <option value="">Choose one…</option>
            {SECTORS.map((s) => (
              <option value={s} selected={profile.sector === s}>{s}</option>
            ))}
          </select>
        </label>
        <label>
          Other sector
          <input name="sector_other" maxlength="200" value={profile.sector_other} />
        </label>

        <fieldset>
          <legend>Areas of interest (up to 3)</legend>
          <div class="interest-grid">
            {INTERESTS.map((i) => (
              <label class="check">
                <input type="checkbox" name="interests" value={i} checked={selectedInterests.has(i)} />
                {i}
              </label>
            ))}
          </div>
        </fieldset>
        <label>
          Other area of interest
          <input name="interest_other" maxlength="200" value={profile.interest_other} />
        </label>

        <label>
          What else would you like to share?
          <textarea name="about" rows="4" maxlength="4000">{profile.about || profile.bio}</textarea>
        </label>

        <label>
          Short bio <span class="optional">(directory blurb)</span>
          <textarea name="bio" rows="3" maxlength="2000">{profile.bio}</textarea>
        </label>
        <label>
          Organization / partner
          <input name="partner_org" maxlength="120" value={profile.partner_org} />
        </label>

        <input type="hidden" name="visibility" value={profile.visibility} />
        <input type="hidden" name="allow_directory" value={profile.allow_directory === 1 ? "on" : ""} />
        <input type="hidden" name="allow_messages" value={profile.allow_messages === 1 ? "on" : ""} />
        <input type="hidden" name="email_updates" value={profile.email_updates === 1 ? "on" : ""} />

        <button class="btn btn--primary" type="submit">Save profile</button>
        <p id="form-status" role="status"></p>
      </form>
    </section>
  ) : (
    <section class="tab-panel" role="tabpanel" aria-labelledby="tab-settings">
      <form id="settings-form" class="stack" style="max-width: 32rem;">
        <input type="hidden" name="display_name" value={profile.display_name} />
        <input type="hidden" name="bio" value={profile.bio} />
        <input type="hidden" name="regions" value={profile.regions || profile.location} />
        <input type="hidden" name="partner_org" value={profile.partner_org} />
        <input type="hidden" name="profile_type" value={profile.profile_type || "steward"} />
        <input type="hidden" name="contact_links" value={profile.contact_links} />
        <input type="hidden" name="map_address" value={profile.map_address} />
        <input type="hidden" name="sector" value={profile.sector} />
        <input type="hidden" name="sector_other" value={profile.sector_other} />
        <input type="hidden" name="interest_other" value={profile.interest_other} />
        <input type="hidden" name="about" value={profile.about} />
        <input type="hidden" name="avatar_url" value={profile.avatar_url || ""} />
        {[...selectedInterests].map((i) => <input type="hidden" name="interests" value={i} />)}

        <label>
          Profile visibility
          <select name="visibility">
            <option value="stewards" selected={profile.visibility === "stewards"}>Stewards only</option>
            <option value="public" selected={profile.visibility === "public"}>Public</option>
            <option value="private" selected={profile.visibility === "private"}>Private</option>
          </select>
        </label>
        <label class="check">
          <input type="checkbox" name="allow_directory" checked={profile.allow_directory === 1} />
          Show me in the alliance directory
        </label>
        <label class="check">
          <input type="checkbox" name="allow_messages" checked={profile.allow_messages === 1} />
          Allow messages from other stewards
        </label>
        <label class="check">
          <input type="checkbox" name="email_updates" checked={profile.email_updates === 1} />
          Email updates and campaigns
        </label>
        <button class="btn btn--primary" type="submit">Save settings</button>
        <p id="settings-status" role="status"></p>
      </form>
    </section>
  )}
</Base>

<style>
  .tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-surface-subtle);
    margin: var(--space-6) 0;
  }

  .tabs__tab {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 700;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .tabs__tab.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-cyan);
  }

  .tab-panel {
    margin-top: var(--space-4);
  }

  select {
    font: inherit;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
  }

  fieldset {
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  legend {
    font-weight: 700;
    padding: 0 var(--space-2);
  }

  .hint,
  .optional {
    display: block;
    font-weight: 400;
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: var(--space-1) 0 var(--space-2);
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-weight: 400;
    margin: var(--space-2) 0;
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-1) var(--space-3);
  }

  .avatar-editor {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .avatar-editor__preview {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface-subtle);
  }

  .avatar-editor__controls {
    flex: 1;
    min-width: 14rem;
  }

  .avatar-upload {
    display: inline-flex;
    margin: var(--space-2) 0 var(--space-3);
    cursor: pointer;
  }

  .avatar-presets {
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .avatar-presets__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .avatar-preset {
    border: 2px solid transparent;
    border-radius: 50%;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .avatar-preset.is-selected,
  .avatar-preset:hover {
    border-color: var(--color-cyan);
  }
</style>

<script>
  async function saveAccount(form: HTMLFormElement, status: HTMLParagraphElement) {
    const interests = [...form.querySelectorAll<HTMLInputElement>('input[name="interests"]')]
      .filter((el) => el.type === "hidden" || el.checked)
      .map((el) => el.value)
      .filter(Boolean);
    const unique = [...new Set(interests)].slice(0, 3);
    if (unique.length > 3) {
      status.textContent = "Please select at most 3 areas of interest.";
      return;
    }

    status.textContent = "Saving…";
    const fields = new FormData(form);
    const allowDirectory =
      form.querySelector<HTMLInputElement>('input[name="allow_directory"][type="checkbox"]')?.checked ??
      fields.get("allow_directory") === "on";
    const allowMessages =
      form.querySelector<HTMLInputElement>('input[name="allow_messages"][type="checkbox"]')?.checked ??
      fields.get("allow_messages") === "on";
    const emailUpdates =
      form.querySelector<HTMLInputElement>('input[name="email_updates"][type="checkbox"]')?.checked ??
      fields.get("email_updates") === "on";

    const res = await fetch("/api/profile", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        display_name: fields.get("display_name"),
        bio: fields.get("bio"),
        location: fields.get("regions"),
        partner_org: fields.get("partner_org"),
        visibility: fields.get("visibility"),
        allow_directory: allowDirectory,
        allow_messages: allowMessages,
        email_updates: emailUpdates,
        profile_type: fields.get("profile_type") || "steward",
        contact_links: fields.get("contact_links"),
        regions: fields.get("regions"),
        map_address: fields.get("map_address"),
        sector: fields.get("sector"),
        sector_other: fields.get("sector_other"),
        interests: unique,
        interest_other: fields.get("interest_other"),
        about: fields.get("about"),
        avatar_url: fields.get("avatar_url") || "",
      }),
    });
    const data = await res.json();
    status.textContent = res.ok ? "Saved." : (data.error ?? "Something went wrong.");
  }

  const profileForm = document.querySelector<HTMLFormElement>("#profile-form");
  const profileStatus = document.querySelector<HTMLParagraphElement>("#form-status");
  if (profileForm && profileStatus) {
    profileForm.addEventListener("submit", (event) => {
      event.preventDefault();
      void saveAccount(profileForm, profileStatus);
    });

    const avatarInput = profileForm.querySelector<HTMLInputElement>("#avatar_url");
    const preview = profileForm.querySelector<HTMLImageElement>("#avatar-preview");
    const fileInput = profileForm.querySelector<HTMLInputElement>("#avatar-file");

    profileForm.querySelectorAll<HTMLButtonElement>(".avatar-preset").forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = btn.dataset.preset ?? "";
        if (avatarInput) avatarInput.value = value;
        const img = btn.querySelector("img");
        if (preview && img) preview.src = img.src;
        profileForm.querySelectorAll(".avatar-preset").forEach((el) => el.classList.remove("is-selected"));
        btn.classList.add("is-selected");
      });
    });

    fileInput?.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file || !avatarInput || !preview) return;
      const bitmap = await createImageBitmap(file);
      const size = 96;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      const scale = Math.max(size / bitmap.width, size / bitmap.height);
      const w = bitmap.width * scale;
      const h = bitmap.height * scale;
      ctx.drawImage(bitmap, (size - w) / 2, (size - h) / 2, w, h);
      const dataUrl = canvas.toDataURL("image/jpeg", 0.7);
      if (dataUrl.length > 24000) {
        profileStatus.textContent = "That photo is still too large after shrinking. Try a simpler image.";
        return;
      }
      avatarInput.value = dataUrl;
      preview.src = dataUrl;
      profileForm.querySelectorAll(".avatar-preset").forEach((el) => el.classList.remove("is-selected"));
    });
  }

  const settingsForm = document.querySelector<HTMLFormElement>("#settings-form");
  const settingsStatus = document.querySelector<HTMLParagraphElement>("#settings-status");
  if (settingsForm && settingsStatus) {
    settingsForm.addEventListener("submit", (event) => {
      event.preventDefault();
      void saveAccount(settingsForm, settingsStatus);
    });
  }
</script>
