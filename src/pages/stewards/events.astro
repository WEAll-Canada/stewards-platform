---
import Base from "../../layouts/Base.astro";
import { currentUser, hasRole } from "../../lib/auth";
import { listCirclesForUser, listEventsForUser } from "../../lib/db";
import {
  buildMonthGrid,
  formatEventWhen,
  isOngoing,
  isToday,
  isUpcoming,
} from "../../lib/events";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const events = await listEventsForUser(user.id);
const circles = await listCirclesForUser(user.id);
const canCreate = hasRole(user, "admin") || hasRole(user, "circle_lead") || hasRole(user, "steward");

const now = new Date();
const happeningNow = events.filter((e) => isOngoing(e, now.getTime()));
const todayEvents = events.filter((e) => isToday(e, now) && !isOngoing(e, now.getTime()));
const upcoming = events.filter((e) => isUpcoming(e, now.getTime()) && !isToday(e, now));
const past = events.filter((e) => !isUpcoming(e, now.getTime())).reverse();

const month = now.getUTCMonth();
const year = now.getUTCFullYear();
const monthLabel = now.toLocaleString("en-CA", { month: "long", year: "numeric", timeZone: "UTC" });
const grid = buildMonthGrid(year, month);
const todayKey = now.toISOString().slice(0, 10);
const eventsByDay = new Map<string, typeof events>();
for (const e of events) {
  const startDay = e.starts_at.slice(0, 10);
  const endDay = (e.ends_at ?? e.starts_at).slice(0, 10);
  let cursor = startDay;
  while (cursor <= endDay) {
    const list = eventsByDay.get(cursor) ?? [];
    list.push(e);
    eventsByDay.set(cursor, list);
    const next = new Date(`${cursor}T00:00:00Z`);
    next.setUTCDate(next.getUTCDate() + 1);
    cursor = next.toISOString().slice(0, 10);
  }
}
---
<Base title="Events" active="events" user={user}>
  <header class="events-intro">
    <div>
      <h1>Events</h1>
      <p class="lede">What’s on now, what’s coming, and a month view for planning.</p>
    </div>
    <div class="view-toggle" role="tablist" aria-label="Events view">
      <button type="button" class="view-toggle__btn is-active" data-view="list" aria-selected="true">List</button>
      <button type="button" class="view-toggle__btn" data-view="calendar" aria-selected="false">Calendar</button>
    </div>
  </header>

  <div data-events-panel="list">
    {happeningNow.length > 0 && (
      <section class="events-section events-section--now">
        <h2>Happening now</h2>
        <ul class="event-list">
          {happeningNow.map((e) => (
            <li data-id={e.id} class="event-item event-item--now">
              <div class="event-item__badge">Live</div>
              <strong>{e.title}</strong>
              <div class="meta">
                {formatEventWhen(e)}
                {e.location && ` · ${e.location}`}
                {e.circle_name && ` · ${e.circle_name}`}
                {e.rsvp && ` · RSVP: ${e.rsvp}`}
              </div>
              {e.description && <p>{e.description}</p>}
              <div class="dir-actions">
                <button class="btn btn--primary rsvp-btn" type="button" data-status="going">Going</button>
                <button class="btn btn--accent rsvp-btn" type="button" data-status="interested">Interested</button>
                <button class="btn btn--quiet rsvp-btn" type="button" data-status="cancelled">Cancel RSVP</button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {todayEvents.length > 0 && (
      <section class="events-section">
        <h2>Today</h2>
        <ul class="event-list">
          {todayEvents.map((e) => (
            <li data-id={e.id} class="event-item event-item--today">
              <strong>{e.title}</strong>
              <div class="meta">
                {formatEventWhen(e)}
                {e.location && ` · ${e.location}`}
                {e.circle_name && ` · ${e.circle_name}`}
                {e.rsvp && ` · RSVP: ${e.rsvp}`}
              </div>
              {e.description && <p>{e.description}</p>}
              <div class="dir-actions">
                <button class="btn btn--primary rsvp-btn" type="button" data-status="going">Going</button>
                <button class="btn btn--accent rsvp-btn" type="button" data-status="interested">Interested</button>
                <button class="btn btn--quiet rsvp-btn" type="button" data-status="cancelled">Cancel RSVP</button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="events-section">
      <h2>Upcoming</h2>
      {upcoming.length === 0 ? (
        <p class="meta">No upcoming events yet.</p>
      ) : (
        <ul class="event-list">
          {upcoming.map((e) => (
            <li data-id={e.id} class="event-item">
              <strong>{e.title}</strong>
              <div class="meta">
                {formatEventWhen(e)}
                {e.location && ` · ${e.location}`}
                {e.circle_name && ` · ${e.circle_name}`}
                {e.rsvp && ` · RSVP: ${e.rsvp}`}
              </div>
              {e.description && <p>{e.description}</p>}
              <div class="dir-actions">
                <button class="btn btn--primary rsvp-btn" type="button" data-status="going">Going</button>
                <button class="btn btn--accent rsvp-btn" type="button" data-status="interested">Interested</button>
                <button class="btn btn--quiet rsvp-btn" type="button" data-status="cancelled">Cancel RSVP</button>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    {past.length > 0 && (
      <section class="events-section events-section--past">
        <h2>Recent</h2>
        <ul class="event-list">
          {past.slice(0, 5).map((e) => (
            <li data-id={e.id} class="event-item">
              <strong>{e.title}</strong>
              <div class="meta">
                {formatEventWhen(e)}
                {e.location && ` · ${e.location}`}
                {e.circle_name && ` · ${e.circle_name}`}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <div data-events-panel="calendar" hidden>
    <section class="calendar">
      <h2>{monthLabel}</h2>
      <div class="calendar__weekdays" aria-hidden="true">
        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
      </div>
      <div class="calendar__grid">
        {grid.map((cell) => {
          const dayEvents = cell.date ? eventsByDay.get(cell.date) ?? [] : [];
          const isCurrent = cell.date === todayKey;
          return (
            <div
              class:list={{
                "calendar__cell": true,
                "is-empty": !cell.date,
                "is-today": isCurrent,
                "has-events": dayEvents.length > 0,
              }}
            >
              {cell.day && <div class="calendar__day">{cell.day}</div>}
              {dayEvents.slice(0, 3).map((e) => (
                <div class="calendar__event" title={e.title}>{e.title}</div>
              ))}
              {dayEvents.length > 3 && <div class="calendar__more">+{dayEvents.length - 3}</div>}
            </div>
          );
        })}
      </div>
    </section>
  </div>

  {canCreate && (
    <section class="add-event" data-add-event>
      <button class="btn btn--quiet add-event__toggle" type="button" aria-expanded="false" data-add-toggle>
        + Add an event
      </button>
      <div class="add-event__form" hidden data-add-panel>
        <h2>Add an event</h2>
        <form id="event-form" class="stack" style="max-width: 32rem;">
          <label>Title <input name="title" required maxlength="200" /></label>
          <label>Starts at (UTC) <input name="startsAt" type="datetime-local" required /></label>
          <label>Ends at (UTC, optional) <input name="endsAt" type="datetime-local" /></label>
          <label>Location <input name="location" maxlength="200" placeholder="Online" /></label>
          <label>Description <textarea name="description" rows="3" maxlength="4000"></textarea></label>
          <label>
            Visibility
            <select name="visibility">
              <option value="stewards">Stewards</option>
              <option value="public">Public</option>
              <option value="circle">Circle only</option>
            </select>
          </label>
          <label>
            Circle (if circle-only)
            <select name="circleId">
              <option value="">—</option>
              {circles.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </label>
          <button class="btn btn--primary" type="submit">Create event</button>
          <p id="event-status" role="status"></p>
        </form>
      </div>
    </section>
  )}
  <p id="rsvp-status" role="status"></p>
</Base>

<style>
  .events-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-6);
  }

  .view-toggle {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    background: var(--color-surface-subtle);
    border-radius: var(--radius-md);
  }

  .view-toggle__btn {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .view-toggle__btn.is-active {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
  }

  .events-section {
    margin-bottom: var(--space-8);
  }

  .events-section h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .events-section--now h2 {
    color: var(--color-hot);
  }

  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .event-item {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .event-item--now {
    border-left: 3px solid var(--color-hot);
    padding-left: var(--space-4);
    background: linear-gradient(90deg, rgba(250, 70, 22, 0.06), transparent 60%);
  }

  .event-item--today {
    border-left: 3px solid var(--color-cyan);
    padding-left: var(--space-4);
  }

  .event-item__badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-hot);
    margin-bottom: var(--space-2);
  }

  .events-section--past {
    opacity: 0.72;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .dir-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .calendar h2 {
    margin: 0 0 var(--space-4);
  }

  .calendar__weekdays,
  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .calendar__weekdays {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-muted);
    text-align: center;
  }

  .calendar__cell {
    min-height: 5.5rem;
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    background: var(--color-surface);
  }

  .calendar__cell.is-empty {
    background: transparent;
    border-color: transparent;
  }

  .calendar__cell.is-today {
    border-color: var(--color-cyan);
    box-shadow: inset 0 0 0 1px var(--color-cyan);
  }

  .calendar__cell.has-events {
    background: linear-gradient(180deg, rgba(0, 169, 224, 0.08), transparent);
  }

  .calendar__day {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .calendar__event {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.15rem;
  }

  .calendar__more {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .add-event {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-surface-subtle);
  }

  .add-event__toggle {
    margin-bottom: var(--space-4);
  }

  .add-event__form h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  select {
    font: inherit;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-surface-subtle);
  }

  @media (max-width: 720px) {
    .calendar__cell {
      min-height: 3.5rem;
    }

    .calendar__event {
      display: none;
    }

    .calendar__cell.has-events .calendar__day::after {
      content: "";
      display: inline-block;
      width: 0.4rem;
      height: 0.4rem;
      margin-left: 0.25rem;
      border-radius: 50%;
      background: var(--color-cyan);
      vertical-align: middle;
    }
  }
</style>

<script>
  const rsvpStatus = document.querySelector<HTMLParagraphElement>("#rsvp-status")!;
  document.querySelectorAll<HTMLElement>(".event-item[data-id]").forEach((row) => {
    row.querySelectorAll<HTMLButtonElement>(".rsvp-btn").forEach((button) => {
      button.addEventListener("click", async () => {
        rsvpStatus.textContent = "Saving RSVP…";
        const res = await fetch("/api/events/rsvp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ eventId: Number(row.dataset.id), status: button.dataset.status }),
        });
        const data = await res.json();
        if (res.ok) {
          location.reload();
          return;
        }
        rsvpStatus.textContent = data.error ?? "Something went wrong.";
      });
    });
  });

  const listPanel = document.querySelector<HTMLElement>('[data-events-panel="list"]');
  const calPanel = document.querySelector<HTMLElement>('[data-events-panel="calendar"]');
  document.querySelectorAll<HTMLButtonElement>(".view-toggle__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>(".view-toggle__btn").forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-selected", b === btn ? "true" : "false");
      });
      const view = btn.dataset.view;
      if (listPanel) listPanel.hidden = view !== "list";
      if (calPanel) calPanel.hidden = view !== "calendar";
    });
  });

  const addRoot = document.querySelector<HTMLElement>("[data-add-event]");
  const addToggle = addRoot?.querySelector<HTMLButtonElement>("[data-add-toggle]");
  const addPanel = addRoot?.querySelector<HTMLElement>("[data-add-panel]");
  addToggle?.addEventListener("click", () => {
    if (!addPanel) return;
    const open = addPanel.hidden;
    addPanel.hidden = !open;
    addToggle.setAttribute("aria-expanded", open ? "true" : "false");
    addToggle.textContent = open ? "Hide add form" : "+ Add an event";
  });

  const toIso = (localValue: string) => {
    if (!localValue) return "";
    return `${localValue}:00Z`;
  };

  const form = document.querySelector<HTMLFormElement>("#event-form");
  const eventStatus = document.querySelector<HTMLParagraphElement>("#event-status");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!eventStatus) return;
    eventStatus.textContent = "Creating…";
    const fields = new FormData(form);
    const res = await fetch("/api/events", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        title: fields.get("title"),
        startsAt: toIso(String(fields.get("startsAt") ?? "")),
        endsAt: toIso(String(fields.get("endsAt") ?? "")) || null,
        location: fields.get("location"),
        description: fields.get("description"),
        visibility: fields.get("visibility"),
        circleId: fields.get("circleId") || null,
      }),
    });
    const data = await res.json();
    if (res.ok) {
      location.reload();
      return;
    }
    eventStatus.textContent = data.error ?? "Something went wrong.";
  });
</script>
