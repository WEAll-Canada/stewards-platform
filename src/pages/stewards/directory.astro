---
import Base from "../../layouts/Base.astro";
import { currentUser } from "../../lib/auth";
import {
  listConnectionsFor,
  listDirectoryFilterOptions,
  listDirectoryStewards,
} from "../../lib/db";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const params = Astro.url.searchParams;
const filters = {
  q: params.get("q") ?? "",
  region: params.get("region") ?? "",
  sector: params.get("sector") ?? "",
  interest: params.get("interest") ?? "",
};
const hasFilters = Boolean(filters.q || filters.region || filters.sector || filters.interest);

const stewards = await listDirectoryStewards(filters);
const options = await listDirectoryFilterOptions();
const connections = await listConnectionsFor(user.id);

function interestList(raw: string) {
  return (raw || "").split("|").filter(Boolean).join(" · ");
}
---
<Base title="Directory" active="directory" user={user}>
  <h1>Alliance directory</h1>
  <p class="lede">Find stewards by name, region, sector, or interest — then connect or message.</p>

  <form class="dir-filters" method="get" action="/stewards/directory" role="search">
    <label class="dir-filters__search">
      Search
      <input type="search" name="q" value={filters.q} placeholder="Name, org, place…" maxlength="100" />
    </label>
    <label>
      Region
      <select name="region">
        <option value="">All regions</option>
        {options.regions.map((r) => (
          <option value={r} selected={filters.region === r}>{r}</option>
        ))}
      </select>
    </label>
    <label>
      Sector
      <select name="sector">
        <option value="">All sectors</option>
        {options.sectors.map((s) => (
          <option value={s} selected={filters.sector === s}>{s}</option>
        ))}
      </select>
    </label>
    <label>
      Interest
      <select name="interest">
        <option value="">All interests</option>
        {options.interests.map((i) => (
          <option value={i} selected={filters.interest === i}>{i}</option>
        ))}
      </select>
    </label>
    <div class="dir-filters__actions">
      <button class="btn btn--primary" type="submit">Filter</button>
      {hasFilters && (
        <a class="btn btn--quiet" href="/stewards/directory">Clear</a>
      )}
    </div>
  </form>

  <p class="dir-count" aria-live="polite">
    {stewards.length === 0
      ? "No stewards match these filters."
      : `${stewards.length} steward${stewards.length === 1 ? "" : "s"}`}
  </p>

  {stewards.length === 0 ? (
    <p class="note">
      {hasFilters
        ? "Try clearing a filter or searching a different name."
        : "No directory profiles yet."}
    </p>
  ) : (
    <ul class="dir-list">
      {stewards.map((s) => (
        <li data-id={s.id}>
          <strong>{s.display_name || "Steward"}</strong>
          {s.partner_org && <span class="org"> · {s.partner_org}</span>}
          <div class="meta">
            {[s.regions || s.location, s.sector].filter(Boolean).join(" · ")}
          </div>
          {s.interests && <div class="meta interests">{interestList(s.interests)}</div>}
          {s.bio && <p>{s.bio}</p>}
          {s.id !== user.id && (
            <div class="dir-actions">
              <label>
                Strength
                <select class="strength">
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3" selected>3</option>
                  <option value="4">4</option>
                </select>
              </label>
              <label>
                Reason
                <select class="reason">
                  <option value="work">work</option>
                  <option value="social">social</option>
                  <option value="learning" selected>learning</option>
                </select>
              </label>
              <button class="btn btn--accent connect-btn" type="button">Save connection</button>
              <button class="btn btn--primary message-btn" type="button">Message</button>
            </div>
          )}
        </li>
      ))}
    </ul>
  )}

  <h2>Your connections</h2>
  {connections.length === 0 ? (
    <p class="note">No connections logged yet.</p>
  ) : (
    <ul class="dir-list">
      {connections.map((c) => (
        <li>
          <strong>{c.display_name}</strong>
          <div class="meta">strength {c.strength} · {c.reason} · {c.direction}</div>
        </li>
      ))}
    </ul>
  )}
  <p id="dir-status" role="status"></p>
</Base>

<style>
  .dir-filters {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr auto;
    gap: var(--space-3);
    align-items: end;
    margin: var(--space-6) 0 var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .dir-filters label {
    margin: 0;
  }

  .dir-filters__actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .dir-count {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }

  .dir-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .dir-list li {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .org,
  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .interests {
    margin-top: 0.15rem;
  }

  .dir-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: end;
    margin-top: var(--space-3);
  }

  .dir-actions label {
    font-size: var(--text-sm);
  }

  select,
  input[type="search"] {
    font: inherit;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-surface-subtle);
    width: 100%;
  }

  h2 {
    margin-top: var(--space-8);
    font-size: var(--text-lg);
  }

  @media (max-width: 900px) {
    .dir-filters {
      grid-template-columns: 1fr 1fr;
    }

    .dir-filters__search,
    .dir-filters__actions {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const status = document.querySelector<HTMLParagraphElement>("#dir-status")!;
  document.querySelectorAll<HTMLElement>(".dir-list > li[data-id]").forEach((row) => {
    const id = Number(row.dataset.id);
    row.querySelector<HTMLButtonElement>(".connect-btn")?.addEventListener("click", async () => {
      status.textContent = "Saving connection…";
      const strength = Number(row.querySelector<HTMLSelectElement>(".strength")?.value);
      const reason = row.querySelector<HTMLSelectElement>(".reason")?.value ?? "learning";
      const res = await fetch("/api/connections", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ toUserId: id, strength, reason }),
      });
      const data = await res.json();
      if (res.ok) {
        status.textContent = "Connection saved.";
        location.reload();
        return;
      }
      status.textContent = data.error ?? "Something went wrong.";
    });

    row.querySelector<HTMLButtonElement>(".message-btn")?.addEventListener("click", async () => {
      status.textContent = "Opening conversation…";
      const res = await fetch("/api/messages/steward", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ toUserId: id, body: "Hi! Connecting via the directory." }),
      });
      const data = await res.json();
      if (res.ok) {
        location.href = `/stewards/messages?thread=${data.threadId}`;
        return;
      }
      status.textContent = data.error ?? "Something went wrong.";
    });
  });
</script>
