---
import Base from "../../../../layouts/Base.astro";
import WeAllCircle from "../../../../components/WeAllCircle.astro";
import { currentUser, hasRole } from "../../../../lib/auth";
import {
  CIRCLE_COLOR_TOKENS,
  getCircleBySlug,
  listCircleMembers,
} from "../../../../lib/db";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const slug = Astro.params.slug ?? "";
const circle = await getCircleBySlug(slug, user.id);
if (!circle) return Astro.redirect("/stewards/circles");

const canEdit = circle.membership === "lead" || hasRole(user, "admin");
if (!canEdit) return Astro.redirect(`/stewards/circles/${slug}`);

const members = await listCircleMembers(circle.id);
const variant = (CIRCLE_COLOR_TOKENS.includes(circle.color_token as (typeof CIRCLE_COLOR_TOKENS)[number])
  ? circle.color_token
  : "master") as (typeof CIRCLE_COLOR_TOKENS)[number];

const colorLabels: Record<(typeof CIRCLE_COLOR_TOKENS)[number], string> = {
  central: "Central",
  knowledge: "Knowledge",
  policy: "Policy",
  liberating: "Liberating tools",
  grassroots: "Grassroots",
  master: "Master / default",
};
---
<Base title={`Edit ${circle.name}`} active="circles" user={user}>
  <p class="crumb">
    <a href="/stewards/circles">Circles</a> /
    <a href={`/stewards/circles/${circle.slug}`}>{circle.name}</a> /
    Edit
  </p>

  <header class="edit-hero">
    <WeAllCircle variant={variant} size={48} animate={true} />
    <div>
      <h1>Edit circle page</h1>
      <p class="lede">Update how this circle appears, then manage leads and members.</p>
    </div>
  </header>

  <section class="edit-section">
    <h2>Page details</h2>
    <form id="circle-details" class="stack" data-slug={circle.slug}>
      <label>Name <input name="name" required maxlength="120" value={circle.name} /></label>
      <label>
        Short description
        <textarea name="description" rows="3" maxlength="1000">{circle.description}</textarea>
      </label>
      <label>
        Welcome note (shown under the title)
        <textarea name="welcomeNote" rows="5" maxlength="4000">{circle.welcome_note}</textarea>
      </label>
      <label>
        Resources intro
        <textarea name="resourcesBlurb" rows="2" maxlength="1000">{circle.resources_blurb}</textarea>
      </label>
      <label>
        Colour mark
        <select name="colorToken">
          {CIRCLE_COLOR_TOKENS.map((token) => (
            <option value={token} selected={circle.color_token === token}>{colorLabels[token]}</option>
          ))}
        </select>
      </label>
      <label>
        Status
        <select name="status">
          <option value="active" selected={circle.status === "active"}>Active (open to join requests)</option>
          <option value="dormant" selected={circle.status === "dormant"}>Dormant (not open to join)</option>
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Save page</button>
      <p id="details-status" role="status"></p>
    </form>
  </section>

  <section class="edit-section">
    <h2>Members & leads</h2>
    <p class="meta">Promote stewards to lead, demote back to member, or remove someone from the circle.</p>
    <ul class="member-manage">
      {members.map((m) => (
        <li data-user-id={m.user_id}>
          <div>
            <strong>{m.display_name}</strong>
            <span class="meta">{m.role}</span>
          </div>
          <div class="member-actions">
            {m.role === "member" ? (
              <button class="btn btn--quiet" type="button" data-action="set_role" data-role="lead">
                Make lead
              </button>
            ) : (
              <button class="btn btn--quiet" type="button" data-action="set_role" data-role="member">
                Make member
              </button>
            )}
            <button class="btn btn--quiet" type="button" data-action="remove">Remove</button>
          </div>
        </li>
      ))}
    </ul>
    <p id="members-status" role="status"></p>
  </section>

  <p><a class="btn btn--accent" href={`/stewards/circles/${circle.slug}`}>View circle page</a></p>
</Base>

<style>
  .crumb {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .crumb a {
    color: var(--color-ink-soft);
  }

  .edit-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-8);
  }

  .edit-hero h1 {
    margin: 0 0 var(--space-2);
  }

  .edit-section {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .edit-section h2 {
    margin: 0 0 var(--space-3);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .stack {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .stack label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .stack input,
  .stack textarea,
  .stack select {
    font: inherit;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-sm);
  }

  .member-manage {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .member-manage li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .member-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

<script>
  const detailsForm = document.querySelector<HTMLFormElement>("#circle-details")!;
  const detailsStatus = document.querySelector<HTMLParagraphElement>("#details-status")!;
  const membersStatus = document.querySelector<HTMLParagraphElement>("#members-status")!;
  const slug = detailsForm.dataset.slug!;

  detailsForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(detailsForm);
    detailsStatus.textContent = "Saving…";
    const res = await fetch("/api/circles/update", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        slug,
        name: data.get("name"),
        description: data.get("description"),
        welcomeNote: data.get("welcomeNote"),
        resourcesBlurb: data.get("resourcesBlurb"),
        colorToken: data.get("colorToken"),
        status: data.get("status"),
      }),
    });
    const json = await res.json();
    detailsStatus.textContent = res.ok ? "Saved." : (json.error ?? "Something went wrong.");
  });

  document.querySelectorAll<HTMLElement>(".member-manage li").forEach((row) => {
    row.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const userId = Number(row.dataset.userId);
        const action = button.dataset.action!;
        membersStatus.textContent = "Updating…";
        const payload: Record<string, unknown> = { slug, userId, action };
        if (action === "set_role") payload.role = button.dataset.role;
        const res = await fetch("/api/circles/members", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (!res.ok) {
          membersStatus.textContent = json.error ?? "Something went wrong.";
          return;
        }
        location.reload();
      });
    });
  });
</script>
