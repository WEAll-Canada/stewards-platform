---
import Base from "../../../layouts/Base.astro";
import CirclesSubnav from "../../../components/CirclesSubnav.astro";
import WeAllCircle from "../../../components/WeAllCircle.astro";
import { currentUser, hasRole } from "../../../lib/auth";
import {
  getCircleBySlug,
  listCircleDecisions,
  listCircleMembers,
  listCircleResources,
  listEventsForUser,
  listUserCircles,
} from "../../../lib/db";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const slug = Astro.params.slug ?? "";
const circle = await getCircleBySlug(slug, user.id);
if (!circle) return Astro.redirect("/stewards/circles");

const myCircles = await listUserCircles(user.id);
const members = await listCircleMembers(circle.id);
const resources = await listCircleResources(circle.id);
const decisions = await listCircleDecisions(circle.id);
const canContribute = !!circle.membership || hasRole(user, "admin");
const canEdit = circle.membership === "lead" || hasRole(user, "admin");
const relatedEvents = (await listEventsForUser(user.id))
  .filter((e) => e.circle_name === circle.name)
  .slice(0, 5);

const variant = (["central", "knowledge", "policy", "liberating", "grassroots"].includes(circle.color_token)
  ? circle.color_token
  : "master") as "central" | "knowledge" | "policy" | "liberating" | "grassroots" | "master";
---
<Base title={circle.name} active="circles" user={user}>
  <CirclesSubnav active={circle.slug} myCircles={myCircles} />

  <header class="circle-hero">
    <WeAllCircle variant={variant} size={64} animate={true} />
    <div>
      <div class="circle-hero__title">
        <h1>{circle.name}</h1>
        {canEdit && (
          <a class="btn btn--quiet" href={`/stewards/circles/${circle.slug}/edit`}>Edit page</a>
        )}
      </div>
      <p class="lede">{circle.description}</p>
      {circle.welcome_note && <p class="welcome">{circle.welcome_note}</p>}
      <p class="meta">
        {circle.member_count} members
        {circle.status === "dormant" && " · dormant"}
        {circle.membership && ` · you are a ${circle.membership}`}
      </p>
    </div>
  </header>

  {!circle.membership && (
    <section class="circle-section">
      {circle.pending_request ? (
        <p class="note">Your join request is pending approval.</p>
      ) : circle.status === "active" ? (
        <button class="btn btn--accent" type="button" id="join-btn" data-id={circle.id}>
          Request to join
        </button>
      ) : (
        <p class="note">This circle is dormant and not open for joins.</p>
      )}
      <p id="join-status" role="status"></p>
    </section>
  )}

  <section class="circle-section">
    <h2>Members</h2>
    {members.length === 0 ? (
      <p class="meta">No members yet.</p>
    ) : (
      <ul class="member-list">
        {members.map((m) => (
          <li>
            <strong>{m.display_name}</strong>
            <span class="meta">{m.role}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="circle-section">
    <h2>Upcoming in this circle</h2>
    {relatedEvents.length === 0 ? (
      <p class="meta">No circle events yet. <a href="/stewards/events">Browse all events</a>.</p>
    ) : (
      <ul class="event-list">
        {relatedEvents.map((e) => (
          <li>
            <time datetime={e.starts_at}>{e.starts_at.slice(0, 10)}</time>
            <div>
              <a href="/stewards/events">{e.title}</a>
              {e.location && <div class="meta">{e.location}</div>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="circle-section">
    <h2>Resources</h2>
    {circle.resources_blurb && <p class="meta resources-blurb">{circle.resources_blurb}</p>}
    {resources.length === 0 ? (
      <p class="meta">No shared resources yet.</p>
    ) : (
      <ul class="resource-list">
        {resources.map((r) => (
          <li>
            <strong>{r.title}</strong>
            <div class="meta">
              {r.created_by_name} · {r.created_at.slice(0, 10)}
            </div>
            {r.url && (
              <p>
                <a href={r.url} target="_blank" rel="noopener noreferrer">{r.url}</a>
              </p>
            )}
            {r.note && <p>{r.note}</p>}
          </li>
        ))}
      </ul>
    )}
    {canContribute && (
      <form id="resource-form" class="inline-form" data-circle-id={circle.id}>
        <h3>Add a resource</h3>
        <label>Title <input name="title" required maxlength="200" /></label>
        <label>Link <input name="url" type="url" maxlength="500" placeholder="https://" /></label>
        <label>Note <textarea name="note" rows="2" maxlength="2000"></textarea></label>
        <button class="btn btn--quiet" type="submit">Save resource</button>
        <p class="form-status" data-resource-status role="status"></p>
      </form>
    )}
  </section>

  <section class="circle-section">
    <h2>Decision log</h2>
    {decisions.length === 0 ? (
      <p class="meta">No decisions recorded yet.</p>
    ) : (
      <ul class="resource-list">
        {decisions.map((d) => (
          <li>
            <strong>{d.title}</strong>
            <div class="meta">
              Decided {d.decided_at.slice(0, 10)} · logged by {d.created_by_name}
            </div>
            {d.detail && <p>{d.detail}</p>}
          </li>
        ))}
      </ul>
    )}
    {canContribute && (
      <form id="decision-form" class="inline-form" data-circle-id={circle.id}>
        <h3>Log a decision</h3>
        <label>Title <input name="title" required maxlength="200" /></label>
        <label>Detail <textarea name="detail" rows="3" maxlength="4000"></textarea></label>
        <label>Decided on <input name="decidedAt" type="date" /></label>
        <button class="btn btn--quiet" type="submit">Save decision</button>
        <p class="form-status" data-decision-status role="status"></p>
      </form>
    )}
  </section>
</Base>

<style>
  .crumb {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .crumb a {
    color: var(--color-ink-soft);
  }

  .circle-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-6);
    align-items: start;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-surface-subtle);
    margin-bottom: var(--space-8);
  }

  .circle-hero__title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .circle-hero h1 {
    margin: 0;
  }

  .welcome {
    max-width: 40rem;
    margin: 0 0 var(--space-3);
    white-space: pre-wrap;
  }

  .resources-blurb {
    margin-bottom: var(--space-3);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-transform: capitalize;
  }

  .circle-section {
    margin-bottom: var(--space-8);
  }

  .circle-section h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .member-list,
  .event-list,
  .resource-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .resource-list li {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .inline-form {
    display: grid;
    gap: var(--space-3);
    max-width: 32rem;
    margin-top: var(--space-5);
  }

  .inline-form h3 {
    margin: 0;
    font-size: var(--text-md);
  }

  .inline-form label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .inline-form input,
  .inline-form textarea {
    font: inherit;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-surface-subtle);
    border-radius: var(--radius-sm);
  }

  .form-status {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .member-list li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .event-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
  }

  .event-list time {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-blue);
    min-width: 6.5rem;
  }

  @media (max-width: 640px) {
    .circle-hero {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("#join-btn");
  const status = document.querySelector<HTMLParagraphElement>("#join-status");
  button?.addEventListener("click", async () => {
    if (!status) return;
    status.textContent = "Sending request…";
    const res = await fetch("/api/circles/join", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ circleId: Number(button.dataset.id) }),
    });
    const data = await res.json();
    if (res.ok) {
      button.replaceWith(
        Object.assign(document.createElement("p"), {
          className: "note",
          textContent: "Your join request is pending approval.",
        }),
      );
      status.textContent = "Request sent.";
      return;
    }
    status.textContent = data.error ?? "Something went wrong.";
  });

  const resourceForm = document.querySelector<HTMLFormElement>("#resource-form");
  resourceForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const statusEl = document.querySelector<HTMLParagraphElement>("[data-resource-status]");
    if (!statusEl) return;
    const data = new FormData(resourceForm);
    statusEl.textContent = "Saving…";
    const res = await fetch("/api/circles/resources", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        circleId: Number(resourceForm.dataset.circleId),
        title: data.get("title"),
        url: data.get("url"),
        note: data.get("note"),
      }),
    });
    const json = await res.json();
    if (!res.ok) {
      statusEl.textContent = json.error ?? "Something went wrong.";
      return;
    }
    location.reload();
  });

  const decisionForm = document.querySelector<HTMLFormElement>("#decision-form");
  decisionForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const statusEl = document.querySelector<HTMLParagraphElement>("[data-decision-status]");
    if (!statusEl) return;
    const data = new FormData(decisionForm);
    statusEl.textContent = "Saving…";
    const res = await fetch("/api/circles/decisions", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        circleId: Number(decisionForm.dataset.circleId),
        title: data.get("title"),
        detail: data.get("detail"),
        decidedAt: data.get("decidedAt"),
      }),
    });
    const json = await res.json();
    if (!res.ok) {
      statusEl.textContent = json.error ?? "Something went wrong.";
      return;
    }
    location.reload();
  });
</script>
