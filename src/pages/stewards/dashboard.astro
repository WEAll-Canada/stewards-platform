---
import Base from "../../layouts/Base.astro";
import WeAllCircle from "../../components/WeAllCircle.astro";
import { currentUser } from "../../lib/auth";
import { listEventsForUser, listUserCircles } from "../../lib/db";
import { isToday, isUpcoming } from "../../lib/events";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const circles = await listUserCircles(user.id);
const allEvents = await listEventsForUser(user.id);
const now = new Date();
const todayEvents = allEvents.filter((e) => isToday(e, now));
const upcoming = allEvents
  .filter((e) => isUpcoming(e, now.getTime()) && !isToday(e, now))
  .slice(0, 5);
const variant = (token: string) =>
  (["central", "knowledge", "policy", "liberating", "grassroots"].includes(token)
    ? token
    : "master") as "central" | "knowledge" | "policy" | "liberating" | "grassroots" | "master";
---
<Base title="Dashboard" active="dashboard" user={user}>
  <header class="dash-intro">
    <h1>Welcome, {user.display_name || "steward"}</h1>
    <p class="lede">Your home base across circles, messages, and events.</p>
  </header>

  <div class="dash-grid">
    <section class="dash-block dash-block--wide">
      <div class="dash-block__mark" aria-hidden="true">
        <WeAllCircle variant="master" size={40} animate={false} />
      </div>
      <div class="dash-block__body">
        <h2>Alliance</h2>
        <p>
          Browse the <a href="/stewards/directory">directory</a>,
          <a href="/stewards/connect">find who shares an interest</a>,
          explore the <a href="/stewards/network">network map</a>,
          or read the <a href="/stewards/faq">FAQ</a>.
        </p>
      </div>
    </section>

    <section class="dash-block">
      <h2>Your circles</h2>
      {circles.length === 0 ? (
        <p>No memberships yet. <a href="/stewards/circles">Request to join</a>.</p>
      ) : (
        <ul class="circle-list">
          {circles.map((c) => (
            <li>
              <WeAllCircle variant={variant(c.color_token)} size={28} animate={false} />
              <div>
                <a href={`/stewards/circles/${c.slug}`}>{c.name}</a>
                <div class="meta">{c.role}</div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="dash-block">
      <h2>Messages</h2>
      <p class="dash-cta">
        <a href="/stewards/messages">Open conversations</a>
      </p>
    </section>

    <section class="dash-block dash-block--wide">
      <h2>Events today</h2>
      {todayEvents.length === 0 ? (
        <p>Nothing on the calendar today. <a href="/stewards/events">See all events</a>.</p>
      ) : (
        <ul class="event-list">
          {todayEvents.map((e) => (
            <li>
              <time datetime={e.starts_at}>{e.starts_at.slice(11, 16)} UTC</time>
              <div>
                <a href="/stewards/events">{e.title}</a>
                {e.circle_name && <div class="meta">{e.circle_name}</div>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="dash-block dash-block--wide">
      <h2>Upcoming</h2>
      {upcoming.length === 0 ? (
        <p>No upcoming events yet. <a href="/stewards/events">See calendar</a>.</p>
      ) : (
        <ul class="event-list">
          {upcoming.map((e) => (
            <li>
              <time datetime={e.starts_at}>{e.starts_at.slice(0, 10)}</time>
              <div>
                <a href="/stewards/events">{e.title}</a>
                {e.circle_name && <div class="meta">{e.circle_name}</div>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>

<style>
  .dash-intro {
    margin-bottom: var(--space-8);
  }

  .dash-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8) var(--space-12);
    align-items: start;
  }

  .dash-block--wide {
    grid-column: 1 / -1;
  }

  .dash-block--wide.dash-block:first-of-type {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-surface-subtle);
  }

  .dash-block h2 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3);
  }

  .dash-block p,
  .dash-cta {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  .dash-block__mark {
    line-height: 0;
    margin-top: 0.15rem;
  }

  .circle-list,
  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .circle-list li,
  .event-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
  }

  .event-list time {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-blue);
    min-width: 6.5rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  @media (max-width: 720px) {
    .dash-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .dash-block--wide {
      grid-column: auto;
    }
  }
</style>
