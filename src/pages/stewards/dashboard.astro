---
import Base from "../../layouts/Base.astro";
import WeAllCircle from "../../components/WeAllCircle.astro";
import { currentUser, hasRole } from "../../lib/auth";
import { getDashboardBundle, listEventsForUser, listUserCircles } from "../../lib/db";
import { isToday, isUpcoming } from "../../lib/events";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status !== "active") return Astro.redirect("/stewards/pending");

const isAdmin = hasRole(user, "admin");
const circles = await listUserCircles(user.id);
const allEvents = await listEventsForUser(user.id);
const dash = await getDashboardBundle(user.id, isAdmin);
const now = new Date();
const todayEvents = allEvents.filter((e) => isToday(e, now));
const upcoming = allEvents
  .filter((e) => isUpcoming(e, now.getTime()) && !isToday(e, now))
  .slice(0, 5);
const variant = (token: string) =>
  (["central", "knowledge", "policy", "liberating", "grassroots"].includes(token)
    ? token
    : "master") as "central" | "knowledge" | "policy" | "liberating" | "grassroots" | "master";
const attentionCount = dash.pendingApplications + dash.pendingCircleJoins;
---
<Base title="Dashboard" active="dashboard" user={user}>
  <header class="dash-intro">
    <h1>Welcome, {user.display_name || "steward"}</h1>
    <p class="lede">Your place to see circles, conversations, and what’s coming next.</p>
  </header>

  <div class="dash-bento">
    <section class="panel panel--hero">
      <div class="panel__mark" aria-hidden="true">
        <WeAllCircle variant="master" size={48} animate={true} />
      </div>
      <div>
        <h2>Alliance</h2>
        <p>
          Browse the <a href="/stewards/directory">directory</a>,{" "}
          <a href="/stewards/connect">find shared interests</a>,{" "}
          explore the <a href="/stewards/network">network map</a>,{" "}
          or open the <a href="/stewards/commons">Knowledge Commons</a>.
        </p>
      </div>
    </section>

    {isAdmin && attentionCount > 0 && (
      <section class="panel panel--attention">
        <h2>Needs attention</h2>
        <p>
          {dash.pendingApplications > 0 && (
            <>
              <a href="/stewards/admin">{dash.pendingApplications} application{dash.pendingApplications === 1 ? "" : "s"}</a>
              {" waiting"}
            </>
          )}
          {dash.pendingApplications > 0 && dash.pendingCircleJoins > 0 && " · "}
          {dash.pendingCircleJoins > 0 && (
            <>
              <a href="/stewards/admin">{dash.pendingCircleJoins} circle request{dash.pendingCircleJoins === 1 ? "" : "s"}</a>
            </>
          )}
        </p>
      </section>
    )}

    <section class="panel">
      <h2>Your circles</h2>
      {circles.length === 0 ? (
        <p>No memberships yet. <a href="/stewards/circles">Request to join</a>.</p>
      ) : (
        <ul class="plain-list">
          {circles.map((c) => (
            <li>
              <WeAllCircle variant={variant(c.color_token)} size={28} animate={false} />
              <div>
                <a href={`/stewards/circles/${c.slug}`}>{c.name}</a>
                <div class="meta">{c.role}</div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="panel">
      <h2>Messages</h2>
      {dash.threads.length === 0 ? (
        <p class="dash-cta"><a href="/stewards/messages">Start a conversation</a></p>
      ) : (
        <ul class="plain-list plain-list--stack">
          {dash.threads.map((t) => (
            <li>
              <a href={`/stewards/messages?thread=${t.id}`}>{t.other_name}</a>
              <div class="meta">{t.preview.slice(0, 90) || "No messages yet"}</div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="panel panel--wide panel--events">
      <h2>Events today</h2>
      {todayEvents.length === 0 ? (
        <p>Nothing on the calendar today. <a href="/stewards/events">See all events</a>.</p>
      ) : (
        <ul class="plain-list plain-list--events">
          {todayEvents.map((e) => (
            <li>
              <time datetime={e.starts_at}>{e.starts_at.slice(11, 16)} UTC</time>
              <div>
                <a href="/stewards/events">{e.title}</a>
                {e.circle_name && <div class="meta">{e.circle_name}</div>}
              </div>
            </li>
          ))}
        </ul>
      )}

      <div class="events-upcoming">
        <h2>Upcoming</h2>
        {upcoming.length === 0 ? (
          <p>No upcoming events yet. <a href="/stewards/events">See calendar</a>.</p>
        ) : (
          <ul class="plain-list plain-list--events">
            {upcoming.map((e) => (
              <li>
                <time datetime={e.starts_at}>{e.starts_at.slice(0, 10)}</time>
                <div>
                  <a href="/stewards/events">{e.title}</a>
                  {e.circle_name && <div class="meta">{e.circle_name}</div>}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="panel panel--wide">
      <h2>From the Commons</h2>
      {dash.commons.length === 0 ? (
        <p><a href="/stewards/commons">Add the first shared note</a>.</p>
      ) : (
        <ul class="plain-list plain-list--stack">
          {dash.commons.map((item) => (
            <li>
              <a href="/stewards/commons">{item.title}</a>
              {item.summary && <div class="meta">{item.summary}</div>}
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>

<style>
  /* Match Events / Commons rhythm: intro → sections with one gap token. */
  .dash-intro {
    margin-bottom: var(--space-6);
    max-width: 40rem;
  }

  .dash-intro h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .dash-intro .lede {
    margin: 0;
  }

  .dash-bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .panel--hero,
  .panel--wide,
  .panel--attention {
    grid-column: 1 / -1;
  }

  .panel--hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .panel--attention {
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
    background: var(--color-surface-subtle);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-warning);
  }

  .panel h2 {
    /* In-app titles stay Lato bold (DESIGN.md); Rubik Mono One is for public heroes. */
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-4);
  }

  .events-upcoming {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-surface-subtle);
  }

  .panel p,
  .dash-cta {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  .panel__mark {
    line-height: 0;
    margin-top: 0.15rem;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .plain-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .plain-list--stack li {
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }

  .plain-list--events time {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-blue);
    min-width: 6.5rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 720px) {
    .dash-bento {
      grid-template-columns: 1fr;
    }

    .panel--hero,
    .panel--wide,
    .panel--attention {
      grid-column: auto;
    }
  }
</style>
