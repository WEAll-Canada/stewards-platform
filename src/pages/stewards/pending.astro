---
import Base from "../../layouts/Base.astro";
import { currentUser } from "../../lib/auth";

const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/stewards/login");
if (user.status === "active") {
  return Astro.redirect(user.roles.includes("admin") ? "/stewards/admin" : "/stewards/dashboard");
}
---
<Base title="Application pending" user={user}>
  <h1>Thanks, {user.display_name || "friend"}</h1>
  <p class="lede">
    Your application is with the admins. You’ll get full steward access once it’s approved —
    then log in again and head to your dashboard.
  </p>
  <p class="note">Signed in as {user.email}</p>
</Base>
