---
interface Props {
  active: "approvals" | "people" | "questions" | "agreement" | "activity" | "analytics";
}
const { active } = Astro.props;

const tabs = [
  { id: "approvals", href: "/stewards/admin", label: "Approvals" },
  { id: "people", href: "/stewards/admin/people", label: "People" },
  { id: "questions", href: "/stewards/admin/questions", label: "Questions" },
  { id: "agreement", href: "/stewards/admin/agreement", label: "Agreement" },
  { id: "activity", href: "/stewards/admin/activity", label: "Activity" },
  { id: "analytics", href: "/stewards/admin/analytics", label: "Analytics" },
] as const;
---
<nav class="tabs" role="tablist" aria-label="Admin sections">
  {tabs.map((tab) => (
    <a
      class:list={["tabs__tab", { "is-active": active === tab.id }]}
      href={tab.href}
      role="tab"
      aria-selected={active === tab.id}
      id={`tab-${tab.id}`}
    >
      {tab.label}
    </a>
  ))}
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-surface-subtle);
    margin: var(--space-6) 0;
  }

  .tabs__tab {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 700;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .tabs__tab.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-cyan);
  }
</style>
