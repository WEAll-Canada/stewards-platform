---
interface Props {
  active: "match" | "network";
}
const { active } = Astro.props;
---
<nav class="tabs" role="tablist" aria-label="Connect sections">
  <a
    class:list={["tabs__tab", { "is-active": active === "match" }]}
    href="/stewards/connect"
    role="tab"
    aria-selected={active === "match"}
    id="tab-match"
  >
    Who is interested?
  </a>
  <a
    class:list={["tabs__tab", { "is-active": active === "network" }]}
    href="/stewards/network"
    role="tab"
    aria-selected={active === "network"}
    id="tab-network"
  >
    Network map
  </a>
</nav>

<style>
  /* Same tab pattern as Profile / Settings */
  .tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-surface-subtle);
    margin: var(--space-6) 0;
  }

  .tabs__tab {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 700;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .tabs__tab.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-cyan);
  }
</style>
