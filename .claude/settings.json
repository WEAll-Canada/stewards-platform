{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run doctor)",
      "Bash(sh scripts/setup-tools.sh)",
      "Bash(sh scripts/check.sh)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/setup-tools.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/check.ps1)",
      "Bash(npm run start)",
      "Bash(npm run ship *)",
      "Bash(npm run sync)",
      "Bash(npm run undo)",
      "Bash(npm run undo *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run types)",
      "Bash(npm ci)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(gh auth status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh repo view*)",
      "Bash(npx wrangler d1 migrations create DB *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(brew *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(nvm install*)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(npm install --global*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git merge*)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler login*)",
      "Bash(npx wrangler secret*)",
      "Bash(npx wrangler * --remote*)",
      "Bash(wrangler *)",
      "Read(/.dev.vars)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.agent/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/**)",
      "Edit(/astro.config.mjs)",
      "Edit(/wrangler.jsonc)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)"
    ]
  }
}
